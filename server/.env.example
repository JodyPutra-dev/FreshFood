# Server Configuration
PORT=3000
NODE_ENV=development

# API Key - Generate strong random key for production
# Example: openssl rand -hex 32

# Client API Key - Used for /manifest.json and /models/* endpoints
# This is the only API key needed for client authentication
# Must match the key configured in Android app's gradle.properties (modelUpdateApiKey)
CLIENT_API_KEY=your-client-api-key-here-change-this-in-production

# Models Directory Configuration
MODELS_DIR=./models
MANIFEST_PATH=./models/manifest.json

# Note: manifest.json must be generated manually using:
# node scripts/generate-manifest.js --server-url <your-server-url>

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: https://your-domain.com,https://app.your-domain.com
# Leave empty or set to * for development (not recommended for production)
ALLOWED_ORIGINS=http://localhost:3000

# Server URL (used for generating download URLs in manifest)
# Example: https://your-domain.com or http://localhost:3000
SERVER_URL=http://localhost:3000
