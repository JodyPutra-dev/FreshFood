# Server Configuration
PORT=3000
NODE_ENV=development

# API Keys - Generate strong random keys for production
# Example: openssl rand -hex 32

# Admin API Key - Used for /admin/* endpoints (model uploads)
ADMIN_API_KEY=your-secret-api-key-here-change-this-in-production

# Client API Key - Used for /manifest.json and /models/* endpoints (model downloads)
# This should be different from ADMIN_API_KEY and must match the key configured in Android app
CLIENT_API_KEY=your-client-api-key-here-change-this-in-production

# Models Directory Configuration
MODELS_DIR=./models
MANIFEST_PATH=./models/manifest.json

# File Upload Configuration
# Maximum upload file size in megabytes
MAX_FILE_SIZE_MB=100

# Rate Limiting Configuration
# Window duration in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: https://your-domain.com,https://app.your-domain.com
# Leave empty or set to * for development (not recommended for production)
ALLOWED_ORIGINS=http://localhost:3000

# Server URL (used for generating download URLs in manifest)
# Example: https://your-domain.com or http://localhost:3000
SERVER_URL=http://localhost:3000
